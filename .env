# ---------- APPLICATION ----------
APP_NAME=NEXORA
APP_ENV=development
DEBUG=true

# ---------- DATASET PATHS ----------
DATA_DIR=data/

MODEL_1_PATH=data/Model_1.csv
MODEL_2_PATH=data/Model_2.csv
PARAMETERS_PATH=data/ParametersFile.xls

# ---------- COMPUTER VISION ----------
MODEL_PATH=models/defect_model.pt
CONFIDENCE_THRESHOLD=0.50
IMAGE_SIZE=640

# ---------- PRODUCTION ANALYTICS ----------
DEMAND_COLUMN=Demand
THROUGHPUT_COLUMN=Parts per hour

DRILLING_UTIL_COLUMN=Drilling Util
MILLING_UTIL_COLUMN=Milling Util
ASSEMBLY_UTIL_COLUMN=Assembly Util

# ---------- BOTTLENECK ANALYSIS ----------
BOTTLENECK_UTIL_THRESHOLD=0.90
HIGH_QUEUE_THRESHOLD=0.80

# ---------- DASHBOARD ----------
HOST=127.0.0.1
PORT=8501

# ---------- LOGGING ----------
LOG_LEVEL=INFO

# ---------- OPTIONAL API ----------
# Leave empty unless your final implementation needs an external API.
API_KEY=